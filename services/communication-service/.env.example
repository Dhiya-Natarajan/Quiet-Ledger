PORT=4003
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/communication_db?schema=public"
JWT_SECRET="quietledger_shared_secret"

# Email Configuration (Nodemailer - Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="quietledgersupport@gmail.com"
SMTP_PASS="your_16_character_app_password"
EMAIL_FROM="quietledgersupport@gmail.com"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
ENABLE_MOCK_SMS=true

# Kafka Configuration
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="communication-service"
KAFKA_GROUP_ID="communication-group"
ENABLE_KAFKA=false
